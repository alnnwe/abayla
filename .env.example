# Скопируйте в .env и заполните. Файл .env не коммитить.
BOT_TOKEN=
# Секрет для HMAC-отпечатков (защита от повторных уведомлений). Сгенерируйте: python -c "import secrets;print(secrets.token_hex(32))"
ABAYLA_HASH_SECRET=
ABAYLA_MODEL_DIR=artifacts/models/tfidf_wordchar
ABAYLA_DB_PATH=abayla.sqlite3
# Только для сетей с перехватом TLS (ошибка CERTIFICATE_VERIFY_FAILED): путь к набору корневых сертификатов
ABAYLA_CA_BUNDLE=
ABAYLA_MAX_TEXT_CHARS=4000
ABAYLA_LINK_TTL_MINUTES=30
ABAYLA_NOTIFY_DEDUP_HOURS=24
ABAYLA_NOTIFY_MAX_PER_HOUR=3

# Необязательно: переформулировка объяснений через LLM (вердикт LLM не определяет)
LLM_ENABLED=0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_API_VERSION=2026-10-21
LLM_TIMEOUT_S=4

# Необязательно: голосовые сообщения (pip install -r requirements-voice.txt)
VOICE_ENABLED=0
WHISPER_MODEL=small
ABAYLA_MAX_VOICE_SECONDS=120
