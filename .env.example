# Скопируйте в .env и заполните. Файл .env не коммитить.
BOT_TOKEN=
# Секрет для HMAC-отпечатков (защита от повторных уведомлений). Сгенерируйте: python -c "import secrets;print(secrets.token_hex(32))"
SAQBOL_HASH_SECRET=
SAQBOL_MODEL_DIR=artifacts/models/tfidf_wordchar
SAQBOL_DB_PATH=saqbol.sqlite3
SAQBOL_MAX_TEXT_CHARS=4000
SAQBOL_LINK_TTL_MINUTES=30
SAQBOL_NOTIFY_DEDUP_HOURS=24
SAQBOL_NOTIFY_MAX_PER_HOUR=3

# Необязательно: переформулировка объяснений через LLM (вердикт LLM не определяет)
LLM_ENABLED=0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_API_VERSION=2026-10-21
LLM_TIMEOUT_S=4

# Необязательно: голосовые сообщения (pip install -r requirements-voice.txt)
VOICE_ENABLED=0
WHISPER_MODEL=small
SAQBOL_MAX_VOICE_SECONDS=120
